{
  "headers": [
    { "source": "/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] },
    { "source": "/sounds/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/mods/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/version.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
